{
  "name": "act-archive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "infisical run --env=dev -- next dev",
    "build": "next build && node scripts/package-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx scripts/seed.ts",
    "check-links": "infisical run --env=dev -- tsx --conditions=react-server scripts/check-links.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "dev:noenv": "next dev",
    "test": "tsx --conditions=react-server --test tests/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "oauth4webapi": "^3.8.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
