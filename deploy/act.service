# /etc/systemd/system/act.service — testauram VM용 예시. 경로·사용자는 VM에서 확인 후 맞춘다.
# 시크릿은 Infisical ACT 프로젝트(prod)에서 주입한다. VM은 머신 아이덴티티 devspace-testauram-vm(Viewer)으로 인증한다.
[Unit]
Description=ACT teacher work archive
After=network.target

[Service]
Type=simple
User=act
WorkingDirectory=/opt/act/current
Environment=NODE_ENV=production
Environment=PORT=3100
Environment=HOSTNAME=127.0.0.1
Environment=DATA_DIR=/var/lib/act
Environment=MIGRATIONS_DIR=/opt/act/current/drizzle
Environment=SITE_URL=https://act.example.com
ExecStart=/usr/bin/infisical run --projectId=67ca8aac-24a4-47ec-b799-31209e64cb90 --env=prod -- /usr/bin/node server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
